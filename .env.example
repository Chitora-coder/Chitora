# Primary API key (required)
GEMINI_API_KEY=your_api_key_here

# Additional keys for key rotation (optional)
# Note: Google blocks by IP, not just key. Use HTTP_PROXY below to change IP.
# GEMINI_API_KEY_2=your_second_key_here
# GEMINI_API_KEY_3=your_third_key_here

# HTTP Proxy to route requests through a different IP (recommended fix for IP-level rate limits)
# Use your VPN's local proxy port, or a mobile hotspot proxy, or any SOCKS/HTTP proxy.
# Examples:
#   HTTP_PROXY=http://127.0.0.1:7890    (Clash/V2Ray VPN local port)
#   HTTP_PROXY=http://127.0.0.1:1080    (common SOCKS proxy)
#   HTTP_PROXY=http://user:pass@proxy.example.com:8080
# HTTP_PROXY=http://127.0.0.1:7890
